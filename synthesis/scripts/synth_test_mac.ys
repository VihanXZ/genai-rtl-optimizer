# Read RTL
read_verilog -sv rtl/test_mac/test_mac_5k.sv
hierarchy -top test_mac_5k
synth -top test_mac_5k
# Map to Sky130
dfflibmap -liberty libs/sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty libs/sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
clean
# Print stats
stat -liberty libs/sky130/sky130_fd_sc_hd__tt_025C_1v80.lib
# Write netlist
write_verilog synthesis/netlists/test_mac_5k_synth.v
