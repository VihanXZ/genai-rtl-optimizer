sta/logs/*.log
openroad/logs/*.log
openroad/results/*.def
openroad/results/*.odb
formal/logs/*.log
*.vcd
*.fst

# --- Large generated files (>10MB rule from dev workflow) ---
*.gds
*.lef.gz

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Streamlit ---
.streamlit/secrets.toml

# Keep directory structure even when contents are ignored
!.gitkeep
