[gold]
read -sv rtl/testcases/bad_mac_array_core.sv rtl/testcases/bad_mac_array_gold_delayed.sv
prep -top bad_mac_array

[gate]
read -sv rtl/candidates/candidate_008.sv
prep -top bad_mac_array

[strategy primary]
